# MQ backend — contoh konfigurasi (copy ke .env, JANGAN commit .env)
LISTEN_ADDR=127.0.0.1:8290
DATABASE_URL=mysql://mq_app:<password>@127.0.0.1:3306/mq_dev
# Object storage = SeaweedFS lokal (MinIO OSS diarsipkan 14Sep; service MQ-SeaweedFS via NSSM)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mq-media
S3_ACCESS_KEY=<dari C:\mq\seaweedfs\s3.json>
S3_SECRET_KEY=<dari C:\mq\seaweedfs\s3.json>
JWT_SECRET=<minimal 32 byte, acak>
CACHE_DRIVER=memory
